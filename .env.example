# Espacio Luz Demo — variables de entorno.
# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.
#   cp .env.example .env   →   docker compose up
APP_ENV=production
# Prefijo de la URL si la app vive en una subcarpeta del hosting (p. ej. /espacioluzdemo). Vacío en Docker.
# APP_BASE=/espacioluzdemo

# Base de datos. Con Docker, DB_HOST lo fija compose.yaml ("db"); en un hosting PHP use localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=espacioluzdemo
DB_USER=espacioluzdemo
DB_PASS=cambiar_esto
# Solo Docker: contraseña del usuario root de MariaDB (la usan el contenedor db y el respaldo)
DB_ROOT_PASSWORD=cambiar_esto_tambien

# Clave para firmar los JWT (mínimo 32 caracteres aleatorios; por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambiar_esto_por_una_cadena_larga_y_aleatoria
JWT_TTL=3600

# Servicio de IA externo (https://console.groq.com). Vacío = POST /ia/resumen responde 503 IA_NO_CONFIGURADA.
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
AI_TIMEOUT=20

# Contraseña de las cuentas de demostración por rol (seeder DatosSinteticos, 10 caracteres o más):
#   admin@espacioluzdemo.cl · recepcion@espacioluzdemo.cl · clinica@espacioluzdemo.cl · gerencia@espacioluzdemo.cl
DEMO_PASSWORD=cambiar_esto_10_o_mas

# Correo: «archivo» guarda los mensajes como .eml en storage/logs/correos (la demo no envía correos).
MAIL_MODO=archivo
# Orígenes externos permitidos por CORS para la API (separados por coma). Vacío = solo el mismo sitio.
CORS_ORIGENES=

# Solo Docker (opcionales). SEED_DEMO=0 en producción: sin datos sintéticos ni cuentas demo.
SEED_DEMO=1
WEB_PORT=8080
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=14
