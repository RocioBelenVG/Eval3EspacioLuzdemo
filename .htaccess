# Espacio Luz (PHP) — enrutamiento por controlador frontal
<IfModule mod_rewrite.c>
    RewriteEngine On

    # API REST: entregar el encabezado Authorization (JWT) a PHP; Apache/LiteSpeed lo descartan con PHP-FPM.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Base automática: si la app vive en un subdirectorio, Apache la resuelve.
    # Si un archivo o carpeta existe físicamente (imágenes, css, js), se sirve tal cual.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás pasa por index.php
    RewriteRule ^ index.php [L]
</IfModule>

# No listar directorios
Options -Indexes

# Bloquear acceso web directo a los .php internos (las inclusiones desde
# index.php son a nivel de sistema de archivos y no se ven afectadas). Las
# rutas del router como /api/content NO terminan en .php, así que no se tocan.
RedirectMatch 404 ^.*/(lib|pages|partials|api)/.*\.php$
RedirectMatch 404 ^.*/(config|data)\.php$

# Proteger los datos JSON (contenido y reservas) de acceso web directo
<FilesMatch "\.(json)$">
    Require all denied
</FilesMatch>

# Excepción: el estilo del mapa sí debe servirse
<Files "map-style.json">
    Require all granted
</Files>

# Secretos y archivos del proyecto que nunca se sirven por la web.
<FilesMatch "^(\.env.*|composer\.(json|lock)|phinx\.php|phpunit\.xml.*|Dockerfile|compose\.ya?ml)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 ^.*/(vendor|database|tests|docker|src|\.git)(/.*)?$

# Cabeceras de seguridad del sitio
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
