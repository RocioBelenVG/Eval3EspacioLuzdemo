{
    "name": "espacioluz/espacioluz-demo",
    "description": "Espacio Luz Demo: gestión de un centro terapéutico (agenda, boxes, pacientes, cobros y documentos tributarios de demostración). Evaluación 3, Lenguaje de Programación Web II.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^6.9",
        "robmorgan/phinx": "^0.16",
        "tecnickcom/tcpdf": "^6.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "EspacioLuz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EspacioLuz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "phinx migrate -c phinx.php",
        "rollback": "phinx rollback -c phinx.php",
        "seed": "phinx seed:run -c phinx.php",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
